# Server port (default: 3000)
PORT=3000

# SQLite database file path (default: ./campfires.db)
DB_PATH=./campfires.db

# JWT signing secret — MUST be set to a unique random value in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# Anthropic API key for AI summarization (optional — falls back to stub summaries if unset)
ANTHROPIC_API_KEY=

# Claude model for summarization (default: claude-haiku-4-5-20250514)
# ANTHROPIC_MODEL=claude-haiku-4-5-20250514
